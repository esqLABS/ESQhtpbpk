                <Info min="-10" max="10" flag="50" seq="2" ref="0" bb="2" group="12" />
              </Parameter>
              <Parameter id="VTgP1hZzlkOBXStM4b_P8w" name="Fraction unbound (plasma, reference value)" description="Fraction unbound in plasma of the reference individual, i.e. in the case of human typically an average healthy adult. This reference value can be scaled to children based on the ontogeny of the respective plasma protein and/or in diseased subjects using the plasma protein scale factor defined in the individual" icon="Parameter" persistable="0" isFixedValue="0" dim="Fraction" quantityType="Parameter" negativeValuesAllowed="1" buildMode="Property" isDefault="1" value="NaN">
