              </Parameter>
              <Parameter id="XHqhkLUjUkmeD7L2tjLA7Q" name="Total oral drug mass" description="Total oral drug mass" icon="Parameter" persistable="0" isFixedValue="0" dim="Amount" quantityType="Parameter" negativeValuesAllowed="1" buildMode="Property" isDefault="1" value="0" displayUnit="µmol">
                <Info min="0" flag="52" seq="1" ref="0" bb="2" group="63" />
              </Parameter>
