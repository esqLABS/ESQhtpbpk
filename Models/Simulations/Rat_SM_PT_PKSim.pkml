              <Parameter id="28ipuyfqzUGVRQJUws9aSg" name="Plasma protein binding partner" description="Plasma protein to which the drug is predominantly bound. The ontogeny of the two most important plasma protein binding partners, albumin and α1-acid glycoprotein (AGP) is available in the PK-Sim database so that the fraction unbound in plasma can be scaled to children using the ontogeny of the respective protein. If  the binding partner is neither albumin nor AGP  or if scaling to children is not of interest, the third alternative (unknown) can be used. Please note that any other ontogeny can be uploaded for the scaling to children using the Population Simulation Toolbox in MoBi" icon="Parameter" persistable="0" isFixedValue="0" quantityType="Parameter" negativeValuesAllowed="1" buildMode="Property" isDefault="1" value="1">
                <Info flag="50" seq="1" ref="0" bb="2" group="9" />
              </Parameter>
              <Parameter id="SvEX4YYxf06TP6uOaezggA" name="Solubility_pKa_pH_Factor" description="pKa/pH-Dependent factor for solubility" icon="Parameter" persistable="0" isFixedValue="0" quantityType="Parameter" negativeValuesAllowed="1" formula="T2vjmW1AJ0usrwd_Mh_htw" buildMode="Property" isDefault="1">
                <Info min="0" flag="52" seq="1" ref="0" bb="2" group="18" />
              </Parameter>
