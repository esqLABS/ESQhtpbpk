              <Parameter id="6IUFUNH_cUqId_zJu7Um2g" name="Kd (FcRn) in endosomal space" description="Dissociation constant of drug for binding to FcRn in endosomal space" icon="Parameter" persistable="0" isFixedValue="0" dim="Concentration (molar)" quantityType="Parameter" negativeValuesAllowed="1" buildMode="Global" isDefault="1" value="999999" displayUnit="µmol/l">
