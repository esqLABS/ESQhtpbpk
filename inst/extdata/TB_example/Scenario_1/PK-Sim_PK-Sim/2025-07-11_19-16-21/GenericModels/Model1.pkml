                        <Info min="0" flag="50" seq="4" ref="0" bb="2" group="18" />
                      </Parameter>
                      <Parameter id="KyTWKOCc8EmzCTX2ZwJPlQ" name="Solubility table" description="Solubility table" icon="Parameter" persistable="0" isFixedValue="0" dim="Concentration (mass)" quantityType="Parameter" negativeValuesAllowed="1" buildMode="Global" isDefault="1" value="0" displayUnit="mg/l">
