                      </Parameter>
                      <Parameter id="OppVx-ufukePJSxyByCXpg" name="Plasma protein binding partner" description="Plasma protein to which the drug is predominantly bound. The ontogeny of the two most important plasma protein binding partners, albumin and α1-acid glycoprotein (AGP) is available in the PK-Sim database so that the fraction unbound in plasma can be scaled to children using the ontogeny of the respective protein. If  the binding partner is neither albumin nor AGP  or if scaling to children is not of interest, the third alternative (unknown) can be used. Please note that any other ontogeny can be uploaded for the scaling to children using the Population Simulation Toolbox in MoBi" icon="Parameter" persistable="0" isFixedValue="0" quantityType="Parameter" negativeValuesAllowed="1" buildMode="Global" isDefault="1" value="1">
                        <Info flag="50" seq="1" ref="0" bb="2" group="9" />
                      </Parameter>
                      <Parameter id="RSRBeapw7k2e0eqySuCjuA" name="Solubility_pKa_pH_Factor" description="pKa/pH-Dependent factor for solubility" icon="Parameter" persistable="0" isFixedValue="0" quantityType="Parameter" negativeValuesAllowed="1" formula="f5mf7tOB-EOvdcuoiS4FVA" buildMode="Global" isDefault="1">
                        <Info min="0" flag="52" seq="1" ref="0" bb="2" group="18" />
                      </Parameter>
                      <Parameter id="90be36tUG0iyWun50CQ3tQ" name="Total drug mass" description="Total drug mass" icon="Parameter" persistable="0" isFixedValue="0" dim="Amount" quantityType="Parameter" negativeValuesAllowed="1" formula="IjVoBZP19kS8SKQKQIuLjA" buildMode="Global" isDefault="1" displayUnit="µmol">
