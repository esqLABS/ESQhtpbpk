                      <Parameter id="uRUXs7TwEkaaEE03rEtCNg" name="Treat precipitated drug as" description="Treat precipitated drug as either soluble or insoluble" icon="Parameter" persistable="0" isFixedValue="0" quantityType="Parameter" negativeValuesAllowed="1" buildMode="Global" isDefault="1" value="1">
                        <Info min="0" max="1" flag="50" seq="30" ref="0" bb="2" group="14" />
                      </Parameter>
                      <Parameter id="HEWVW7tEX0K02Gz13WB15w" name="Aqueous diffusion coefficient" description="Aqueous diffusion coefficient&#xA;of the drug" icon="Parameter" persistable="0" isFixedValue="0" dim="Diffusion coefficient" quantityType="Parameter" negativeValuesAllowed="1" formula="2SgDXwZ7yk2f96b8EtufjA" buildMode="Global" isDefault="1" displayUnit="cm²/min">
                        <ValueOrigin id="32" source="Publication" description="Willmann S, Thelen K, Becker C, et al. Mechanism-based prediction of particle size-dependent dissolution and absorption: cilostazol pharmacokinetics in dogs. Eur J Pharm Biopharm. 2010 Sep;76(1):83-94 https://doi.org/10.1016/j.ejpb.2010.06.003" />
